{
	"name": "@bruckner-online/bruckner-online-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "astro build",
		"dev": "astro dev",
		"edition:build": "bash src/scripts/edition/build.sh",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint --deny-warnings .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"test:unit": "tsx --test tests/*.test.ts",
		"types:check": "astro check",
		"typesense:populate": "dotenv -c -- tsx ./src/scripts/populate-typesense.ts"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.5",
		"@acdh-oeaw/validate-env": "^0.1.1",
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/node": "^11.1.9",
		"@astrojs/react": "^7.1.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/solid-js": "^7.1.1",
		"@floating-ui/dom": "^1.7.4",
		"@fontsource-variable/open-sans": "^5.2.7",
		"@fontsource/open-sans-condensed": "^4.5.5",
		"@iconify-json/lucide": "^1.2.73",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.5.48",
		"@mdx-js/mdx": "^3.1.1",
		"@sindresorhus/slugify": "^3.0.0",
		"@types/leaflet": "^1.9.21",
		"algoliasearch": "^5.44.0",
		"astro": "^7.4.2",
		"astro-icon": "^1.1.5",
		"cva": "^1.0.0-beta.4",
		"estree-util-value-to-estree": "^3.5.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.1",
		"instantsearch.js": "^4.83.0",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"lucide-react": "^0.554.0",
		"mirador": "4.1.0",
		"nodemailer": "^7.0.10",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"rehype-mdx-import-media": "^1.2.0",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^5.2.0",
		"remark-smartypants": "^3.0.2",
		"retext-smartypants": "^6.2.0",
		"sharp": "^0.34.5",
		"simple-datatables": "^10.2.0",
		"solid-js": "^1.9.13",
		"typesense": "^2.0.3",
		"typesense-instantsearch-adapter": "^2.9.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"valibot": "^1.1.0",
		"vfile": "^6.0.3",
		"vite": "^8.3.5"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^2.3.2",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.2",
		"@astrojs/ts-plugin": "^1.10.12",
		"@playwright/test": "^1.56.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/estree": "^1.0.8",
		"@types/hast": "^3.0.4",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/mdast": "^4.0.4",
		"@types/mdx": "^2.0.13",
		"@types/node": "^24.10.1",
		"@types/nodemailer": "^7.0.3",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"axe-core": "^4.11.0",
		"axe-playwright": "^2.2.2",
		"dotenv": "^17.2.3",
		"dotenv-cli": "^11.0.0",
		"dotenv-expand": "^12.0.3",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-playwright": "^2.12.1",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-solid": "0.14.5",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"mdast-util-mdx-jsx": "^3.2.0",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2004",
		"schema-dts": "^1.1.5",
		"stylelint": "^16.25.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.6",
		"type-fest": "^5.2.0",
		"typescript": "^5.9.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			"chrome >= 111",
			"edge >= 111",
			"firefox >= 128",
			"safari >= 16.4",
			"ios_saf >= 16.4"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	},
	"engines": {
		"node": "^24"
	},
	"packageManager": "pnpm@12.15.0"
}
