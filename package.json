{
	"name": "@bruckner-online/bruckner-online-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "astro build",
		"dev": "astro dev",
		"edition:build": "bash src/scripts/edition/build.sh",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint --deny-warnings .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup",
		"setup": "is-in-ci || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"test:unit": "node --test tests/*.test.ts",
		"types:check": "astro check",
		"typesense:populate": "node --env-file-if-exists=.env.local ./src/features/bibliography/scripts/populate-typesense.ts"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^0.3.7",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/node": "^11.1.14",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.6",
		"@astrojs/solid-js": "^7.1.6",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@fontsource/open-sans-condensed": "^4.5.5",
		"@iconify-json/lucide": "^1.2.157",
		"@keystatic/astro": "^6.0.0",
		"@keystatic/core": "^0.6.10",
		"@mdx-js/mdx": "^3.1.1",
		"@sindresorhus/slugify": "^4.0.1",
		"@types/leaflet": "^1.9.22",
		"algoliasearch": "^5.65.0",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"better-result": "^3.0.1",
		"cva": "^1.0.0-beta.12",
		"estree-util-value-to-estree": "^3.5.0",
		"hast-util-heading-rank": "^3.0.0",
		"hast-util-to-string": "^3.0.1",
		"instantsearch.js": "^4.123.1",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"lucide-react": "^1.77.0",
		"mirador": "4.3.0",
		"nodemailer": "^10.6.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-mdx-import-media": "^1.4.0",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"remark-smartypants": "^3.0.3",
		"retext-smartypants": "^6.2.0",
		"sharp": "^0.35.5",
		"simple-datatables": "^10.3.0",
		"solid-js": "^1.9.20",
		"typesense": "^3.2.0",
		"typesense-instantsearch-adapter": "^3.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"valibot": "^1.5.0",
		"vfile": "^6.0.3",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.12",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/ts-plugin": "^1.11.0",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/estree": "^1.0.10",
		"@types/hast": "^3.0.5",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/mdast": "^4.0.4",
		"@types/mdx": "^2.0.14",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.1",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.11.0",
		"eslint-plugin-playwright": "^2.12.2",
		"eslint-plugin-regexp": "^3.3.3",
		"eslint-plugin-solid": "0.20.1",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"mdast-util-mdx-jsx": "^3.2.2",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"tailwindcss": "^4.3.5",
		"type-fest": "^6.0.3",
		"typescript": "^6.0.3"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			"chrome >= 111",
			"edge >= 111",
			"firefox >= 128",
			"safari >= 16.4",
			"ios_saf >= 16.4"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	},
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.21.0"
}
