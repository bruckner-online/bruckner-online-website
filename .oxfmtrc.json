{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"astro": true,
	"ignorePatterns": ["content/**", "pnpm-lock.yaml"],
	"proseWrap": "always",
	"sortPackageJson": {
		"sortScripts": true
	},
	"useTabs": true,
	"sortImports": {
		"groups": [
			["side_effect"],
			["side_effect_style"],
			["style"],
			["builtin"],
			["external"],
			["internal", "subpath"],
			["unknown"]
		]
	}
}
