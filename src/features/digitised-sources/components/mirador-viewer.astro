---
import siglumWabMapping from "~/src/features/digitised-sources/data/siglum_wab_mapping.json";

interface Props {
	aga?: string | null;
	siglum?: string | null;
	presentationPath: string;
	sidePanel: boolean;
	viewType: "ImageView" | "ThumbnailsView";
	source: "hss" | "ed" | "aga";
	wabId?: string | null;
}

const IIIFBaseURL = "https://iiifpresentation.acdh.oeaw.ac.at";

const { aga, siglum, presentationPath, sidePanel, viewType, source, wabId } = Astro.props;

const getSigla = (wabId?: string) => {
	return siglumWabMapping
		.filter((x) => {
			return !wabId || x.WAB.split(" ").includes(wabId);
		})
		.map((x) => {
			return x.Signatur;
		});
};

let loadedManifest;
const catalog = [];

switch (source) {
	case "hss":
		if (!siglum && !wabId) {
			const sigla = getSigla();
			loadedManifest = sigla[0]
				? `${IIIFBaseURL}/${presentationPath}/${sigla[0]}/manifest`
				: undefined;
			sigla.forEach((s) => {
				const manifestUrl = `${IIIFBaseURL}/${presentationPath}/${s}/manifest`;
				catalog.push({ manifestId: manifestUrl });
			});
		}
		if (siglum) {
			loadedManifest = `${IIIFBaseURL}/${presentationPath}/${siglum}/manifest`;
			catalog.push({
				manifestId: loadedManifest,
			});
		}
		if (wabId && !siglum) {
			const sigla = getSigla(wabId);
			loadedManifest = sigla[0]
				? `${IIIFBaseURL}/${presentationPath}/${sigla[0]}/manifest`
				: undefined;
			sigla.forEach((s) => {
				const manifestUrl = `${IIIFBaseURL}/${presentationPath}/${s}/manifest`;
				catalog.push({ manifestId: manifestUrl });
			});
		}
		break;
	case "ed":
		if (wabId) {
			loadedManifest = `${IIIFBaseURL}/${presentationPath}/${wabId}/manifest`;
		}
		break;
	case "aga":
		if (aga) {
			loadedManifest = `${IIIFBaseURL}/${presentationPath}/${aga}/manifest`;
		}
		break;
}

const windows = [{ loadedManifest, sidePanel, viewType }];
---

<mirador-viewer
	id="mirador-viewer"
	data-presentation-path={presentationPath}
	data-windows={JSON.stringify(windows)}
	data-catalog={JSON.stringify(catalog)}
	style="height: 600px; /* stylelint-disable-line no-invalid-position-declaration -- Valid inline style reserves space before CSS loads. */"
></mirador-viewer>

<p id="viewer-unavailable" role="status" hidden>
	Die Digitalisate sind derzeit nicht verfügbar.{" "}
	<button type="button" class="underline">
		Erneut versuchen
	</button>
</p>
<script>
	import { openViewer } from "../viewer";

	class MiradorViewer extends HTMLElement {
		connectedCallback() {
			const unavailable = document.querySelector<HTMLElement>("#viewer-unavailable")!;
			const retry = unavailable.querySelector("button")!;
			const open = async () => {
				retry.disabled = true;
				this.hidden = false;
				const windows = JSON.parse(this.dataset.windows!);
				unavailable.hidden = true;
				const available = await openViewer({
					manifest: windows[0]?.loadedManifest,
					start: async () => {
						// @ts-expect-error No type definitions available for mirador
						const { default: Mirador } = await import("mirador");
						Mirador.viewer({
							id: this.id,
							preserveManifestOrder: true,
							showAddFromURLBox: false,
							catalog: JSON.parse(this.dataset.catalog!),
							windows,
							workspace: { isWorkspaceAddVisible: true },
						});
					},
				});
				retry.disabled = false;
				unavailable.hidden = available;
				this.hidden = !available;
			};
			retry.addEventListener("click", () => {
				void open();
			});
			void open();
		}
	}
	customElements.define("mirador-viewer", MiradorViewer);
</script>
