---
import { selectSource, type SourceSelection } from "../source-viewing";

type Props = SourceSelection;

const view = selectSource(Astro.props);
---

<mirador-viewer
	id="mirador-viewer"
	data-view={JSON.stringify(view)}
	style="height: 600px; /* stylelint-disable-line no-invalid-position-declaration -- Valid inline style reserves space before CSS loads. */"
></mirador-viewer>

<p id="viewer-unavailable" role="status" hidden>
	Die Digitalisate sind derzeit nicht verfügbar.{" "}
	<button type="button" class="underline">
		Erneut versuchen
	</button>
</p>
<script>
	import { openSourceView } from "../source-viewing/browser";

	class MiradorViewer extends HTMLElement {
		connectedCallback() {
			const unavailable = document.querySelector<HTMLElement>("#viewer-unavailable")!;
			const retry = unavailable.querySelector("button")!;
			const open = async () => {
				retry.disabled = true;
				this.hidden = false;
				const view = JSON.parse(this.dataset.view!);
				unavailable.hidden = true;
				const available = await openSourceView(this.id, view);
				retry.disabled = false;
				unavailable.hidden = available;
				this.hidden = !available;
			};
			retry.addEventListener("click", () => {
				void open();
			});
			void open();
		}
	}
	customElements.define("mirador-viewer", MiradorViewer);
</script>
