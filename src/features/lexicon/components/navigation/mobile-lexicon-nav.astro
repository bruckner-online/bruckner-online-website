---
import NavLink from "@/components/navigation/nav-link.astro";
import { defaultLocale, type Locale } from "@/config/i18n.config";
import { mobileLexiconNavId } from "@/features/lexicon/components/navigation/constants";
import { createLexiconLinks } from "@/features/lexicon/components/navigation/links";
import { createI18n } from "@/lib/i18n";

const { t } = await createI18n((Astro.currentLocale ?? defaultLocale) as Locale);

const links = createLexiconLinks(t);
---

<div id={mobileLexiconNavId} hidden class="px-4 pb-6 lg:hidden" data-mobile-lexicon-nav>
	<ul class="grid gap-y-2 text-[#555]" role="list">
		{links.map((item) => {
			return (
				<li>
					<NavLink class="transition hover:text-[#212529]" href={item.href}>
						{item.label}
					</NavLink>
				</li>
			);
		})}
	</ul>
</div>
