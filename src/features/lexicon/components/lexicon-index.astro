---
import { lexicon, pathnames, type Category } from "@/features/lexicon/client";
import LexiconUnavailable from "@/features/lexicon/components/lexicon-unavailable.astro";

interface Props {
	errorMessage: string;
	emptyMessage: string;
	letter: string;
	start: number;
	max: number;
	category?: Category;
}

const { errorMessage, emptyMessage, ...query } = Astro.props;
const result = await lexicon.listArticles(query);
---

{result.status === "error" ? (
	<LexiconUnavailable message={errorMessage} />
) : result.value.items.length === 0 ? (
	<p>{emptyMessage}</p>
) : (
	<div class="grid gap-y-4">
		<ol class="grid" role="list">
			{result.value.items.map(({ id, title }) => (
				<li>
					<a class="underline" href={`${pathnames.Artikel}${id}`}>
						{title}
					</a>
				</li>
			))}
		</ol>
	</div>
)}
