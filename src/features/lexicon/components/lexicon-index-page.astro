---
import { defaultLocale, type Locale } from "@/config/i18n.config";
import type { Category } from "@/features/lexicon/client";
import LexiconAlphabetLinks from "@/features/lexicon/components/lexicon-alphabet-links.astro";
import LexiconAuthorsIndex from "@/features/lexicon/components/lexicon-index-authors.astro";
import LexiconLiteratureIndex from "@/features/lexicon/components/lexicon-index-literature.astro";
import LexiconIndex from "@/features/lexicon/components/lexicon-index.astro";
import LexiconLayout from "@/features/lexicon/layouts/lexicon-layout.astro";
import { parseLexiconIndexQuery } from "@/features/lexicon/query";
import PageLayout from "@/layouts/page-layout.astro";
import { readPage } from "@/lib/content/page";
import { createI18n } from "@/lib/i18n";

interface Props {
	contentPath: string;
	category?: Category;
	kind?: "articles" | "authors" | "literature";
}

const { contentPath, category, kind = "articles" } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { t } = await createI18n(locale);
const errorMessage = t("SearchResults.error");
const emptyMessage = t("SearchResults.nothing-found");

const { page, Content } = await readPage(contentPath, locale);

const documentTitle = page.title;
const { title } = page;

const { letter, start } = parseLexiconIndexQuery(Astro.url.searchParams);
---

<PageLayout locale={locale} title={documentTitle}>
	<LexiconLayout title={title}>
		<div class="prose">
			<Content />
		</div>

		<LexiconAlphabetLinks current={letter} />
		{kind === "authors" ? (
			<LexiconAuthorsIndex
				errorMessage={errorMessage}
				emptyMessage={emptyMessage}
				letter={letter}
				start={start}
				max={500}
			/>
		) : kind === "literature" ? (
			<LexiconLiteratureIndex
				errorMessage={errorMessage}
				emptyMessage={emptyMessage}
				letter={letter}
				start={start}
				max={500}
			/>
		) : (
			<LexiconIndex
				category={category}
				errorMessage={errorMessage}
				emptyMessage={emptyMessage}
				letter={letter}
				start={start}
				max={500}
			/>
		)}
	</LexiconLayout>
</PageLayout>
