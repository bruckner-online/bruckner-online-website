---
import { pathnames, type lexicon } from "@/features/lexicon/client";
import LexiconUnavailable from "@/features/lexicon/components/lexicon-unavailable.astro";

interface Props {
	errorMessage: string;
	emptyMessage: string;
	result: Awaited<ReturnType<typeof lexicon.listAuthors>>;
}

const { errorMessage, emptyMessage, result } = Astro.props;
---

{result.status === "error" ? (
	<LexiconUnavailable message={errorMessage} />
) : result.value.items.length === 0 ? (
	<p>{emptyMessage}</p>
) : (
	<div class="grid gap-y-4">
		<ol class="grid" role="list">
			{result.value.items
				.toSorted((a, b) => a.sortName.localeCompare(b.sortName))
				.map(({ name }) => (
					<li>
						<a class="underline" href={`${pathnames.Autor}${name}`}>
							{name}
						</a>
					</li>
				))}
		</ol>
	</div>
)}
