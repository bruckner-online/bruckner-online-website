---
import { log } from "@acdh-oeaw/lib";

import { lexicon, pathnames } from "@/features/lexicon/client";

interface Props {
	errorMessage: string;
	emptyMessage: string;
	letter: string;
	start: number;
	max: number;
}

const { errorMessage, emptyMessage, ...query } = Astro.props;
const result = await lexicon.listAuthors(query);
if (result.status === "error") {
	log.error(result.error);
}
---

{result.status === "error" ? (
	<p>{errorMessage}</p>
) : result.value.items.length === 0 ? (
	<p>{emptyMessage}</p>
) : (
	<div class="grid gap-y-4">
		<ol class="grid" role="list">
			{result.value.items
				.toSorted((a, b) => a.sortName.localeCompare(b.sortName))
				.map(({ name }) => (
					<li>
						<a class="underline" href={`${pathnames.Autor}${name}`}>
							{name}
						</a>
					</li>
				))}
		</ol>
	</div>
)}
