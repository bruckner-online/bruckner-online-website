---
import { Icon } from "astro-icon/components";

import SubmitButton from "@/components/form/submit-button.astro";
import { defaultLocale, type Locale } from "@/config/i18n.config";
import { createI18n } from "@/lib/i18n";

interface Props {
	q?: string;
	field?: "all" | "title";
}

const { q, field } = Astro.props;

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { t } = await createI18n(locale);
---

<form
	action="/lexikon/suche"
	class="grid grid-cols-[1fr_auto_auto] gap-x-4"
	method="get"
	role="search"
>
	<label>
		<div class="sr-only">{t("LexiconSearchForm.search")}</div>
		<input
			class="size-full rounded-md border px-4 py-2"
			name="q"
			placeholder={t("LexiconSearchForm.search")}
			type="search"
			value={q}
		/>
	</label>

	<label class="relative">
		<div class="sr-only">{t("LexiconSearchForm.field")}</div>
		<select
			class="h-full appearance-none rounded-md border py-2 pl-4 pr-10 forced-colors:appearance-auto"
			name="field"
		>
			<option selected={field === "all"} value="all">
				{t("LexiconSearchForm.all-fields")}
			</option>
			<option selected={field === "title"} value="title">
				{t("LexiconSearchForm.headings")}
			</option>
		</select>
		<Icon
			aria-hidden="true"
			class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 forced-colors:hidden"
			name="lucide:chevron-down"
		/>
	</label>

	<input name="start" type="hidden" value="1" />

	<SubmitButton>{t("LexiconSearchForm.search")}</SubmitButton>
</form>
