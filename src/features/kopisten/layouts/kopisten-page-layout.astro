---
import WebsiteFooter from "@/features/kopisten/components/website-footer-kopisten.astro";
import PageLayout, { type Props as PageLayoutProps } from "@/layouts/page-layout.astro";

type Props = PageLayoutProps;

const { description, locale, robots, title } = Astro.props;
---

<PageLayout description={description} locale={locale} robots={robots} title={title}>
	<slot />
	<WebsiteFooter slot="footer" />
</PageLayout>
