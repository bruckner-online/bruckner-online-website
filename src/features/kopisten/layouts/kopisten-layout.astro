---
import MainContent from "@/components/main-content.astro";
import PageSection from "@/components/page-section.astro";
import { KopistenLanguageToggle } from "@/features/kopisten/components/kopisten-language-toggle";
import KopistenNav from "@/features/kopisten/components/kopisten-nav.astro";
import { generateUniqueId } from "@/lib/generate-unique-id";

interface Props {
	title: string;
	image?: string | null;
	languageToggle?: boolean;
	bg?: boolean;
	shadow?: boolean;
}

const { bg = true, shadow = true, languageToggle = false } = Astro.props;
const contentId = generateUniqueId();
---

<MainContent>
	<div class="bg-white">
		<div class="mx-auto flex w-full max-w-screen-lg items-center justify-end pe-8 pt-4 text-md font-medium">
			<KopistenNav />
		</div>
	</div>
	<PageSection>
		{languageToggle && (
			<KopistenLanguageToggle
				contentId={contentId}
				languages={["de", "en"]}
				client:only="solid-js"
			/>
		)}
		<div
			id={contentId}
			data-kopisten-language={languageToggle ? "de" : undefined}
			class:list={["prose my-2", { "bg-white": bg }, { "shadow-lg shadow-neutral-500": shadow }]}
		>
			<slot />
		</div>
	</PageSection>
</MainContent>
