---
import { defaultLocale, type Locale } from "@/config/i18n.config";
import { createI18n } from "@/lib/i18n";

interface Props {
	tracks: Array<{ title: string; file: string }>;
}

const { tracks } = Astro.props;
const { t } = await createI18n((Astro.currentLocale ?? defaultLocale) as Locale);
---

<audio-player
	class="not-prose grid gap-y-2 text-neutral-800"
	role="group"
	aria-label={t("AudioPlayer.playlist")}
	data-selected-label={t("AudioPlayer.selected")}
	data-playing-label={t("AudioPlayer.playing")}
	data-paused-label={t("AudioPlayer.paused")}
	data-ended-label={t("AudioPlayer.ended")}
	data-error-label={t("AudioPlayer.error")}
>
	<ul class="hidden gap-y-1" role="list" data-playlist>
		{tracks.map((track, index) => (
			<li class="grid">
				<button
					type="button"
					class="select-none rounded-md border px-4 py-1 text-left transition hover:bg-neutral-100 aria-[current=true]:bg-neutral-100 aria-[current=true]:font-semibold"
					data-audio-track
					data-title={track.title}
					data-href={track.file}
					aria-current={index === 0 ? "true" : undefined}
				>
					{track.title}
				</button>
			</li>
		))}
	</ul>
	<noscript>
		<ul class="grid gap-y-1" role="list">
			{tracks.map((track) => (
				<li>
					<a class="underline" href={track.file}>
						{track.title}
					</a>
				</li>
			))}
		</ul>
	</noscript>
	<audio
		controls
		preload="none"
		src={tracks[0]?.file}
		aria-label={t("AudioPlayer.controls")}
		class="w-full"
	/>
	<div role="status" aria-live="polite" aria-atomic="true" data-track-title>
		{tracks[0] ? `${t("AudioPlayer.selected")} ${tracks[0].title}` : null}
	</div>
</audio-player>

<script>
	import { assert } from "@acdh-oeaw/lib";

	class AudioPlayer extends HTMLElement {
		private disconnect?: () => void;

		connectedCallback() {
			this.disconnect?.();
			const audio = this.querySelector("audio");
			const playlist = this.querySelector<HTMLElement>("[data-playlist]");
			const status = this.querySelector<HTMLElement>("[data-track-title]");
			const tracks = [...this.querySelectorAll<HTMLButtonElement>("[data-audio-track]")];
			assert(audio);
			assert(playlist);
			assert(status);
			if (tracks.length === 0) {
				return;
			}
			const controller = new AbortController();
			const { signal } = controller;
			let current = Math.max(
				0,
				tracks.findIndex((track) => {
					return track.getAttribute("aria-current") === "true";
				}),
			);
			let request = 0;

			const updateStatus = (state: "selected" | "playing" | "paused" | "ended" | "error") => {
				const label = this.getAttribute(`data-${state}-label`);
				assert(label);
				const text = state === "error" ? label : `${label} ${tracks[current]!.dataset.title!}`;
				if (status.textContent !== text) {
					status.textContent = text;
				}
			};
			const playTrack = async (index: number) => {
				const pending = ++request;
				const track = tracks[index];
				assert(track?.dataset.href);
				if (current !== index || audio.getAttribute("src") !== track.dataset.href || audio.error) {
					audio.src = track.dataset.href;
				}
				current = index;
				tracks.forEach((item, trackIndex) => {
					if (trackIndex === current) {
						item.setAttribute("aria-current", "true");
					} else {
						item.removeAttribute("aria-current");
					}
				});
				updateStatus("selected");
				try {
					await audio.play();
					if (pending === request && !signal.aborted && !audio.paused) {
						updateStatus("playing");
					}
				} catch (error) {
					if (
						pending === request &&
						!signal.aborted &&
						!(error instanceof DOMException && error.name === "AbortError")
					) {
						updateStatus("error");
					}
				}
			};
			tracks.forEach((track, index) => {
				track.addEventListener(
					"click",
					() => {
						void playTrack(index);
					},
					{ signal },
				);
			});
			audio.addEventListener(
				"play",
				() => {
					updateStatus("playing");
				},
				{ signal },
			);
			audio.addEventListener(
				"pause",
				() => {
					if (!audio.ended && !audio.error) {
						updateStatus("paused");
					}
				},
				{ signal },
			);
			audio.addEventListener(
				"error",
				() => {
					updateStatus("error");
				},
				{ signal },
			);
			audio.addEventListener(
				"ended",
				() => {
					if (current < tracks.length - 1) {
						void playTrack(current + 1);
					} else {
						updateStatus("ended");
					}
				},
				{ signal },
			);
			playlist.classList.remove("hidden");
			playlist.classList.add("grid");
			this.disconnect = () => {
				controller.abort();
				request++;
				audio.pause();
			};
		}

		disconnectedCallback() {
			this.disconnect?.();
			this.disconnect = undefined;
		}
	}

	customElements.define("audio-player", AudioPlayer);
</script>
