---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import { defaultLocale, type Locale } from "@/config/i18n.config";
import { generateUniqueId } from "@/lib/generate-unique-id";
import { getImageImport } from "@/lib/get-image-import";
import { createI18n } from "@/lib/i18n";

interface Props {
	title: string;
	slides: ReadonlyArray<{
		title: string;
		summary: string;
		alignment: "left" | "right";
		image: string;
		page: string;
	}>;
}

const { slides, title } = Astro.props;
const featured = slides[0];
const otherSlides = slides.slice(1);

const id = generateUniqueId();

/** Slides span the page section, which is `max-w-screen-lg` with `p-4`. */
const widths = [480, 768, 1140];
const sizes = "(min-width: 1024px) 992px, calc(100vw - 2rem)";

const { t } = await createI18n((Astro.currentLocale as Locale | undefined) ?? defaultLocale);
---

<image-carousel>
	<div
		role="group"
		aria-roledescription="carousel"
		aria-label={title}
		class="group relative"
		data-carousel
		data-state="paused"
	>
		<div data-controls>
			<div class="absolute left-2 top-2 z-10 md:left-8 md:top-8">
				<button
					class="rounded-md bg-[#00000080] p-2 text-white transition hover:bg-[#000000a0] focus-visible:bg-[#000000a0] focus-visible:outline-white"
					aria-controls={id}
					aria-label={t("ImageCarousel.start")}
					data-start-label={t("ImageCarousel.start")}
					data-stop-label={t("ImageCarousel.stop")}
					data-control-toggle
					type="button"
				>
					<Icon
						aria-hidden="true"
						class="hidden size-6 group-data-[state=playing]:block"
						name="lucide:circle-pause"
					/>
					<Icon
						aria-hidden="true"
						class="hidden size-6 group-data-[state=paused]:block"
						name="lucide:circle-play"
					/>
				</button>
			</div>
			<div class="absolute right-2 top-2 z-10 flex gap-2 md:right-8 md:top-8">
				<button
					aria-controls={id}
					aria-label={t("ImageCarousel.previous")}
					class="rounded-md bg-[#00000080] p-2 text-white transition hover:bg-[#000000a0] focus-visible:bg-[#000000a0] focus-visible:outline-white"
					data-control-previous
					type="button"
				>
					<Icon aria-hidden="true" class="size-6" name="lucide:chevron-left" />
				</button>
				<button
					aria-controls={id}
					aria-label={t("ImageCarousel.next")}
					class="rounded-md bg-[#00000080] p-2 text-white transition hover:bg-[#000000a0] focus-visible:bg-[#000000a0] focus-visible:outline-white"
					data-control-next
					type="button"
				>
					<Icon aria-hidden="true" class="size-6" name="lucide:chevron-right" />
				</button>
			</div>
		</div>

		<div
			id={id}
			aria-live="polite"
			aria-atomic="false"
			class="relative grid overflow-hidden"
			data-carousel-items
		>
			{slides.map((slide, index) => {
				const alignments = {
					left: "md:left-0",
					right: "md:right-0",
				};

				const href = `/${slide.page}`;

				return (
					<div
						data-carousel-item
						data-active={index === 0 ? "" : undefined}
						role="group"
						aria-roledescription="slide"
						aria-label={t("ImageCarousel.slide", {
							current: index + 1,
							total: slides.length,
						})}
						class="group invisible relative grid translate-x-1/3 grid-rows-[auto_1fr] [grid-area:1/1] opacity-0 transition-[opacity,translate,visibility] duration-500 data-[active]:visible data-[active]:translate-x-0 data-[active]:opacity-100"
					>
						<a
							class="block aspect-[2.125] -outline-offset-2 focus-visible:outline-white"
							aria-label={slide.title}
							href={href}
						>
							<Image
								alt=""
								class="size-full object-cover"
								fetchpriority={index === 0 ? "high" : undefined}
								loading={index === 0 ? "eager" : undefined}
								sizes={sizes}
								src={getImageImport(slide.image)}
								widths={widths}
							/>
						</a>
						<div
							class:list={[
								"grid content-start gap-y-2 border-t-4 border-brand-red bg-white p-6 text-neutral-800 md:absolute md:bottom-0 md:w-96 md:bg-[#00000080] md:p-8 md:text-white",
								alignments[slide.alignment],
							]}
						>
							<h2 class="text-xl font-bold">
								<a class="md:focus-visible:outline-white" href={href}>
									{slide.title}
								</a>
							</h2>
							<hr class="my-1 border-neutral-300 md:border-[#666]" />
							<div>{slide.summary}</div>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</image-carousel>

<noscript>
	<style is:inline>
		[data-carousel] {
			display: none;
		}
	</style>
	{featured && (
		<section aria-label={title} class="grid gap-y-4" data-carousel-fallback>
			<a
				href={`/${featured.page}`}
				aria-labelledby={`${id}-featured-title`}
				aria-describedby={`${id}-featured-summary`}
				class="block bg-white text-neutral-800 shadow-lg"
			>
				<Image
					alt=""
					class="aspect-[2.125] w-full object-cover"
					loading="eager"
					sizes={sizes}
					src={getImageImport(featured.image)}
					widths={widths}
				/>
				<div class="grid gap-y-2 p-6">
					<h2 class="text-xl font-bold underline" id={`${id}-featured-title`}>
						{featured.title}
					</h2>
					<p id={`${id}-featured-summary`}>{featured.summary}</p>
				</div>
			</a>
			{otherSlides.length > 0 && (
				<div class="grid gap-y-3 bg-white p-6 text-neutral-800">
					<h2 class="text-lg font-semibold">{t("ImageCarousel.more-topics")}</h2>
					<ul class="grid list-disc gap-y-2 ps-5" role="list">
						{otherSlides.map((slide) => (
							<li>
								<a class="underline hover:text-brand-red" href={`/${slide.page}`}>
									{slide.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</section>
	)}
</noscript>

<script>
	import { assert } from "@acdh-oeaw/lib";

	class ImageCarousel extends HTMLElement {
		disconnect: (() => void) | null = null;

		connectedCallback() {
			this.disconnect?.();
			const controller = new AbortController();
			const { signal } = controller;
			const root = this.querySelector<HTMLDivElement>("[data-carousel]");
			const container = this.querySelector<HTMLDivElement>("[data-carousel-items]");
			const slides = [...this.querySelectorAll<HTMLDivElement>("[data-carousel-item]")];
			const toggle = this.querySelector<HTMLButtonElement>("[data-control-toggle]");
			const previous = this.querySelector<HTMLButtonElement>("[data-control-previous]");
			const next = this.querySelector<HTMLButtonElement>("[data-control-next]");
			assert(root);
			assert(container);
			assert(slides.length);
			assert(toggle);
			assert(previous);
			assert(next);
			const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
			let requested = !motion.matches && !root.contains(document.activeElement);
			let hoverPaused = root.matches(":hover");
			let current = 0;
			let timer: ReturnType<typeof setInterval> | null = null;
			let pointerWasPlaying: boolean | null = null;

			function updateSlide() {
				slides.forEach((slide, index) => {
					const active = index === current;
					slide.toggleAttribute("data-active", active);
					slide.inert = !active;
					slide.setAttribute("aria-hidden", String(!active));
				});
			}

			const updateRotation = () => {
				if (timer !== null) {
					clearInterval(timer);
				}
				timer = null;
				const playing = requested && !hoverPaused && slides.length > 1;
				root.dataset.state = playing ? "playing" : "paused";
				container.setAttribute("aria-live", playing ? "off" : "polite");
				toggle.setAttribute(
					"aria-label",
					(playing ? toggle.dataset.stopLabel : toggle.dataset.startLabel)!,
				);
				if (playing) {
					timer = setInterval(() => {
						current = (current + 1) % slides.length;
						updateSlide();
					}, 5000);
				}
			};

			function stopRotation() {
				requested = false;
				updateRotation();
			}

			previous.addEventListener(
				"click",
				() => {
					stopRotation();
					current = (current + slides.length - 1) % slides.length;
					updateSlide();
				},
				{ signal },
			);
			next.addEventListener(
				"click",
				() => {
					stopRotation();
					current = (current + 1) % slides.length;
					updateSlide();
				},
				{ signal },
			);
			// Remember the action before pointer focus pauses rotation (notably on touch).
			toggle.addEventListener(
				"pointerdown",
				() => {
					pointerWasPlaying = timer !== null;
				},
				{ signal },
			);
			toggle.addEventListener(
				"pointercancel",
				() => {
					pointerWasPlaying = null;
				},
				{ signal },
			);
			toggle.addEventListener(
				"click",
				(event) => {
					const wasPlaying =
						event.detail > 0 && pointerWasPlaying !== null ? pointerWasPlaying : timer !== null;
					pointerWasPlaying = null;
					requested = !wasPlaying;
					// An explicit start works while the rotation button is focused or hovered.
					hoverPaused = false;
					updateRotation();
				},
				{ signal },
			);
			root.addEventListener("focusin", stopRotation, { signal });
			root.addEventListener(
				"pointerenter",
				(event) => {
					if (event.pointerType !== "touch") {
						hoverPaused = true;
						updateRotation();
					}
				},
				{ signal },
			);
			root.addEventListener(
				"pointerleave",
				(event) => {
					if (event.pointerType !== "touch") {
						hoverPaused = false;
						updateRotation();
					}
				},
				{ signal },
			);
			motion.addEventListener(
				"change",
				() => {
					if (motion.matches) {
						stopRotation();
					}
				},
				{ signal },
			);
			updateSlide();
			updateRotation();
			this.disconnect = () => {
				controller.abort();
				if (timer !== null) {
					clearInterval(timer);
				}
			};
		}

		disconnectedCallback() {
			this.disconnect?.();
			this.disconnect = null;
		}
	}

	customElements.define("image-carousel", ImageCarousel);
</script>

<style is:global>
	image-carousel {
		display: contents;
	}
</style>
