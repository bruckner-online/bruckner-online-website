---
interface Props {
	class?: string;
	label: string;
}

const { class: className, label } = Astro.props;
---

<nav-bar>
	<nav aria-label={label} class:list={["inline-flex items-center gap-x-4", className]}>
		<slot />
	</nav>
</nav-bar>

<script is:inline>
	/**
	 * In the initial html, all menus are open, so they work when javascript is disabled.
	 * Close them as soon as javascript loads.
	 */
	document.querySelectorAll("div[data-nav-menu]").forEach((element) => {
		// @ts-expect-error - `dataset` is missing in the types
		element.dataset.open = "false";
	});
	document.querySelectorAll("button[data-nav-menu-trigger]").forEach((element) => {
		element.setAttribute("aria-expanded", "false");
	});
</script>

<script>
	import { assert } from "@acdh-oeaw/lib";
	import { computePosition, shift } from "@floating-ui/dom";

	interface NavMenu {
		menu: HTMLDivElement;
		trigger: HTMLButtonElement;
		popover: HTMLDivElement;
	}

	class NavBar extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const { signal } = this.controller;
			let current: NavMenu | null = null;

			function closeMenu(item: NavMenu) {
				item.trigger.setAttribute("aria-expanded", "false");
				item.menu.dataset.open = "false";
				if (current === item) {
					current = null;
				}
			}

			function openMenu(item: NavMenu) {
				if (current != null) {
					closeMenu(current);
				}
				item.trigger.setAttribute("aria-expanded", "true");
				item.menu.dataset.open = "true";
				current = item;
				void computePosition(item.trigger, item.popover, {
					middleware: [shift({ padding: 8 })],
					placement: "bottom",
					strategy: "absolute",
				}).then(({ x, y }) => {
					if (!signal.aborted && current === item) {
						Object.assign(item.popover.style, { left: `${x}px`, top: `${y}px` });
					}
				});
			}

			this.querySelectorAll<HTMLDivElement>("div[data-nav-menu]").forEach((menu) => {
				const trigger = menu.querySelector<HTMLButtonElement>("button[data-nav-menu-trigger]");
				const popover = menu.querySelector<HTMLDivElement>("div[data-popover]");
				assert(trigger);
				assert(popover);
				const item = { menu, trigger, popover };
				closeMenu(item);

				trigger.addEventListener(
					"click",
					() => {
						if (current === item) {
							closeMenu(item);
						} else {
							openMenu(item);
						}
					},
					{ signal },
				);

				menu.addEventListener(
					"keydown",
					(event) => {
						const links = [...popover.querySelectorAll<HTMLAnchorElement>("a[href]")];
						const index = links.indexOf(document.activeElement as HTMLAnchorElement);
						switch (event.key) {
							case "Escape":
								if (current !== item) {
									return;
								}
								closeMenu(item);
								trigger.focus();
								break;
							case "ArrowDown":
								if (event.target === trigger) {
									openMenu(item);
									links[0]?.focus();
								} else if (index !== -1) {
									links[(index + 1) % links.length]?.focus();
								} else {
									return;
								}
								break;
							case "ArrowUp":
								if (index === -1) {
									return;
								}
								links[(index - 1 + links.length) % links.length]?.focus();
								break;
							case "Home":
							case "End":
								if (index === -1) {
									return;
								}
								links.at(event.key === "Home" ? 0 : -1)?.focus();
								break;
							default:
								return;
						}
						event.preventDefault();
					},
					{ signal },
				);

				menu.addEventListener(
					"focusout",
					(event) => {
						// A null target can mean focus left the window, or a Safari button click.
						if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) {
							closeMenu(item);
						}
					},
					{ signal },
				);
			});

			document.addEventListener(
				"pointerdown",
				(event) => {
					if (current != null && !current.menu.contains(event.target as Node)) {
						closeMenu(current);
					}
				},
				{ signal },
			);

			/** Pages restored from the back/forward cache keep their state. */
			window.addEventListener(
				"pagehide",
				() => {
					if (current != null) {
						closeMenu(current);
					}
				},
				{ signal },
			);
		}

		disconnectedCallback() {
			this.controller?.abort();
		}
	}

	customElements.define("nav-bar", NavBar);
</script>

<style is:global>
	nav-bar {
		display: contents;
	}
</style>
