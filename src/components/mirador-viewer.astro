---
import siglumWabMapping from "~/src/data/siglum_wab_mapping.json";

interface Props {
	id: string;
	presentationPath: string;
	sidePanel: boolean;
	viewType: "ImageView" | "ThumbnailsView";
	source: "hss" | "ed" | "aga";
	wabId?: string;
}

const IIIFBaseURL = "https://iiifpresentation.acdh.oeaw.ac.at";

const { id, presentationPath, sidePanel, viewType, source, wabId } = Astro.props;

const getSiglaByWabid = (wabId: string) => {
	return siglumWabMapping
		.filter((x) => {
			return x.WAB.split(" ").includes(wabId);
		})
		.map((x) => {
			return x.Signatur;
		});
};

const loadedManifest = `${IIIFBaseURL}/${presentationPath}/${id}/manifest`;
const catalog = [
	{
		manifestId: loadedManifest,
	},
];

switch (source) {
	case "hss":
		if (wabId) {
			const sigla = getSiglaByWabid(wabId);
			sigla.forEach((s) => {
				const manifestUrl = `${IIIFBaseURL}/${presentationPath}/${s}/manifest`;
				if (!(manifestUrl !== loadedManifest)) {
					catalog.push({ manifestId: manifestUrl });
				}
			});
		}
}

const windows = [
	{
		loadedManifest,
		sidePanel,
		viewType,
	},
];
---

<mirador-viewer
	id="mirador-viewer"
	data-presentation-path={presentationPath}
	data-windows={JSON.stringify(windows)}
	data-catalog={JSON.stringify(catalog)}
	style="height: 600px;"></mirador-viewer>

<script>
	// @ts-expect-error No type definitions available for mirador
	import Mirador from "mirador";

	class MiradorViewer extends HTMLElement {
		connectedCallback() {
			Mirador.viewer({
				id: "mirador-viewer",
				preserveManifestOrder: true,
				showAddFromURLBox: false,
				catalog: JSON.parse(this.dataset.catalog!),
				windows: JSON.parse(this.dataset.windows!),
			});
		}
	}

	customElements.define("mirador-viewer", MiradorViewer);
</script>
