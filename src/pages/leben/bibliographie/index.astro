---
import MainContent from "@/components/main-content.astro";
import PageCard from "@/components/page-card.astro";
import PageSection from "@/components/page-section.astro";
import PageTitle from "@/components/page-title.astro";
import { defaultLocale, type Locale } from "@/config/i18n.config";
import Search from "@/features/bibliography/components/search.astro";
import PageLayout from "@/layouts/page-layout.astro";
import { readPage } from "@/lib/content/page";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;

const { page, Content } = await readPage("leben/bibliographie", locale);

const documentTitle = page.title;
const { title, image } = page;
---

<PageLayout locale={locale} title={documentTitle}>
	<MainContent>
		<PageSection variant="full-height">
			<PageCard image={image}>
				<PageTitle>{title}</PageTitle>
				<div>
					<Content />
					<Search />
				</div>
			</PageCard>
		</PageSection>
	</MainContent>
</PageLayout>
