---
import MiradorViewer from "@/components/mirador-viewer.astro";

const { id } = Astro.params;

const wabId = Astro.url.searchParams.get("wab") || "";

export const prerender = false;
---

<MiradorViewer
	viewType="ThumbnailsView"
	sidePanel={false}
	source="hss"
	id={id!}
	wabId={wabId}
	presentationPath="bruckner"
/>
