---
import { assert } from "@acdh-oeaw/lib";

import { defaultLocale, type Locale } from "@/config/i18n.config";
import { lexicon } from "@/features/lexicon/client";
import Citation from "@/features/lexicon/components/citation.astro";
import LexiconUnavailable from "@/features/lexicon/components/lexicon-unavailable.astro";
import LexiconLayout from "@/features/lexicon/layouts/lexicon-layout.astro";
import PageLayout from "@/layouts/page-layout.astro";
import { reader } from "@/lib/content/reader";
import { createI18n } from "@/lib/i18n";

export const prerender = false;

const { id } = Astro.params;
assert(id, "Missing id.");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { t } = await createI18n(locale);

const page = await reader().collections.pages.readOrThrow("lexikon/artikel");

const documentTitle = page.title;
const { title } = page;

const result = await lexicon.getArticle(id);

// Unavailable responses must remain retryable on the next request.
if (Astro.cache.enabled && result.status === "ok") {
	Astro.cache.set({ maxAge: 3600 });
}
---

<PageLayout locale={locale} title={documentTitle}>
	<LexiconLayout title={title}>
		{result.status === "ok" ? (
			<>
				<div class="prose" set:html={result.value} />
				<Citation id={id} />
			</>
		) : (
			<LexiconUnavailable message={t("SearchResults.error")} />
		)}
	</LexiconLayout>
</PageLayout>
