---
import { assert } from "@acdh-oeaw/lib";

import { defaultLocale, type Locale } from "@/config/i18n.config";
import { lexicon, pathnames } from "@/features/lexicon/client";
import LexiconUnavailable from "@/features/lexicon/components/lexicon-unavailable.astro";
import LexiconLayout from "@/features/lexicon/layouts/lexicon-layout.astro";
import { parseLexiconPagination } from "@/features/lexicon/query";
import PageLayout from "@/layouts/page-layout.astro";
import { reader } from "@/lib/content/reader";
import { createI18n } from "@/lib/i18n";

export const prerender = false;

const { id } = Astro.params;
assert(id, "Missing id.");

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { t } = await createI18n(locale);

const page = await reader().collections.pages.readOrThrow("lexikon/autorinnen");

const { start } = parseLexiconPagination(Astro.url.searchParams);

const result = await lexicon.listArticles({ author: id, start, max: 500 });

// Unavailable responses must remain retryable on the next request.
if (Astro.cache.enabled && result.status === "ok") {
	Astro.cache.set({ maxAge: 600 });
}

const title = t("ArticlesByAuthor.title", { author: id }) ?? page.title;
---

<PageLayout locale={locale} title={title}>
	<LexiconLayout title={title}>
		{result.status === "ok" ? (
			Number(result.value.total) !== 0 ? (
				<div class="grid gap-y-4">
					<ol class="grid" role="list">
						{result.value.items.map((article) => {
							const { id, title } = article;

							return (
								<li>
									<a class="underline" href={`${pathnames["Artikel"]}${id}`}>
										{title}
									</a>
								</li>
							);
						})}
					</ol>
				</div>
			) : (
				<div>{t("SearchResults.nothing-found")}</div>
			)
		) : (
			<LexiconUnavailable message={t("SearchResults.error")} />
		)}
	</LexiconLayout>
</PageLayout>
