---
import MiradorViewer from "@/features/digitised-sources/components/mirador-viewer.astro";

const wabId = Astro.url.searchParams.get("wabId");

export const prerender = false;
---

<MiradorViewer
	sidePanel={false}
	viewType="ImageView"
	source="ed"
	wabId={wabId}
	presentationPath="bruckner/drucke"
/>
