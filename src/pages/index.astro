---
import { Icon } from "astro-icon/components";

import ImageCarousel from "@/components/content/image-carousel.astro";
import MainContent from "@/components/main-content.astro";
import PageSection from "@/components/page-section.astro";
import { defaultLocale, type Locale } from "@/config/i18n.config";
import PageLayout from "@/layouts/page-layout.astro";
import { reader } from "@/lib/content/reader";
import { createI18n } from "@/lib/i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const { t } = await createI18n(locale);

const page = await reader().singletons.indexPage.readOrThrow();

const documentTitle = t("IndexPage.meta.title");
const { hero, links, quote } = page;
---

<PageLayout locale={locale} title={documentTitle}>
	<MainContent class="pb-12 pt-6">
		<h1 class="sr-only">Bruckner Online</h1>

		<PageSection>
			<ImageCarousel slides={hero.slides} title={t("IndexPage.carousel.title")} />
		</PageSection>

		<PageSection>
			<blockquote class="flex items-start gap-x-4 bg-white p-6 text-sm shadow-xl md:gap-x-6 md:p-8 md:text-base lg:text-lg">
				<Icon aria-hidden="true" class="size-8 shrink-0 md:size-10" name="lucide:quote" />
				{quote}
			</blockquote>
		</PageSection>

		<PageSection>
			<div class="grid grid-cols-1 gap-6 md:grid-cols-3">
				{links.map((link, index) => {
					const colors = ["bg-brand-orange", "bg-brand-red", "bg-brand-blue"];
					const bg = colors[index % 3];

					return (
						<a
							class:list={[
								bg,
								"grid grid-cols-[auto_1fr] content-start gap-x-4 text-sm px-6 py-4 text-white transition hover:-translate-y-1 focus-visible:-translate-y-1 focus-visible:outline-offset-2",
							]}
							href={`/${link.page}`}
						>
							<div class="row-span-2 inline-flex items-start">
								<Icon aria-hidden="true" class="-mt-0.5 size-6 shrink-0" name="lucide:database" />
							</div>
							<strong class="uppercase">{link.title}</strong>
							<div>{link.summary}</div>
						</a>
					);
				})}
			</div>
		</PageSection>
	</MainContent>
</PageLayout>

<script>
	import { resolveLegacyPageId } from "@/lib/legacy-urls";

	// The homepage is prerendered, so the middleware never sees links to WordPress pages of the previous site.
	const location = resolveLegacyPageId(new URLSearchParams(window.location.search));
	if (location != null) {
		window.location.replace(location);
	}
</script>
