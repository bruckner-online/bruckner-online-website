{
	"$schema": "https://lefthook.dev/schema.json",
	"glob_matcher": "doublestar",
	"pre-commit": {
		"piped": true,
		"jobs": [
			{
				"name": "lint-code",
				"glob": "**/*.{astro,js,ts,tsx}",
				"run": "pnpm exec oxlint --fix --deny-warnings {staged_files}",
				"stage_fixed": true
			},
			{
				"name": "lint-styles",
				"glob": "**/*.{astro,css}",
				"run": "pnpm exec stylelint --cache --fix {staged_files}",
				"stage_fixed": true
			},
			{
				"name": "format",
				"exclude": ["content/**"],
				"run": "pnpm exec oxfmt --write --no-error-on-unmatched-pattern {staged_files}",
				"stage_fixed": true
			}
		]
	}
}
